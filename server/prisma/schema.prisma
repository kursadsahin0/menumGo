generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id
  fullName            String
  email               String    @unique
  phone               String
  passwordHash         String
  emailVerifiedAt      DateTime?
  verifyTokenHash      String?
  verifyTokenExpiresAt DateTime?
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  tenant              Tenant?
  sessions            Session[]
  pushSubscriptions   PushSubscription[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Tenant {
  id           String        @id
  name         String
  slug         String        @unique
  businessType String        @default("cafe")
  description  String        @default("")
  logo         String?       @db.Text
  coverImage   String?       @db.Text
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?
  products     Product[]
  categories   Category[]
  menuSettings MenuSettings?
  menuViews    MenuView[]
  productViews ProductView[]
  tables        DiningTable[]
  notifications Notification[]
}

model Notification {
  id        String    @id
  tenantId  String
  title     String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model DiningTable {
  id          String     @id
  name        String
  tableNumber String
  isActive    Boolean    @default(true)
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  views       MenuView[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([tenantId, tableNumber])
  @@index([tenantId])
}

model MenuView {
  id        String       @id
  tenantId  String
  language  String
  tableId   String?
  createdAt DateTime     @default(now())
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table     DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model ProductView {
  id         String   @id
  tenantId   String
  productId  String
  categoryId String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model Category {
  id            String   @id
  name          String
  nameEn        String   @default("")
  description   String   @default("")
  descriptionEn String   @default("")
  image         String?  @db.Text
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, sortOrder])
}

model Product {
  id              String   @id
  name            String
  nameEn          String   @default("")
  description     String   @default("")
  descriptionEn   String   @default("")
  portion         String   @default("")
  portionEn       String   @default("")
  ingredients     String   @default("")
  ingredientsEn   String   @default("")
  allergens       String[] @default([])
  price           Decimal  @db.Decimal(10, 2)
  discountedPrice Decimal? @db.Decimal(10, 2)
  image           String?  @db.Text
  categoryId      String
  isAvailable     Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  sortOrder       Int      @default(0)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, sortOrder])
}

model MenuSettings {
  id                String   @id
  name              String
  descriptionTr     String   @default("")
  descriptionEn     String   @default("")
  phone             String   @default("")
  addressTr         String   @default("")
  addressEn         String   @default("")
  website           String   @default("")
  instagram         String   @default("")
  wifiName          String   @default("")
  wifiPassword      String   @default("")
  hoursTr           String   @default("")
  hoursEn           String   @default("")
  logo              String?  @db.Text
  theme             String   @default("classic")
  primaryColor      String   @default("#1f3a34")
  secondaryColor    String   @default("#8d6a45")
  font              String   @default("sans")
  cardStyle         String   @default("soft")
  logoPosition      String   @default("center")
  showDescriptions  Boolean  @default(true)
  showProductImages Boolean  @default(true)
  showPrices        Boolean  @default(true)
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Subscription {
  id       String @id
  status   String
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id
  userId    String
  endpoint  String   @unique @db.Text
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateHit {
  id        String   @id
  bucket    String
  ip        String
  createdAt DateTime @default(now())

  @@index([bucket, ip, createdAt])
}
