# Yerel: Quasar proxy /api → :3000
# Netlify: netlify.toml /api/* → Render (bu değeri /api bırakın veya boş)
VITE_API_BASE_URL=/api

# Yerel UI'nin canlı API/DB kullanması için (ekle/sil canlıya yansır).
# Sadece local backend ile çalışmak için satırı silin veya yorumlayın.
# DEV_API_PROXY_TARGET=https://menumgo-api.onrender.com
